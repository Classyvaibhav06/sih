# ─── AdaptiveX AI — Backend Environment ──────────────────────────────────
# Copy this file to .env and fill in values

# App
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-super-secret-change-in-production-minimum-32-chars

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adaptivex

# Redis (for caching, jobs)
REDIS_URL=redis://localhost:6379

# AI Providers (leave empty to use fallback demo mode)
AI_PROVIDER=fallback
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Demo Mode
DEMO_MODE=true
